# Cloudflare Pages がESモジュールを正しく配信するための明示的なMIME設定。
/core/*
  Content-Type: text/javascript; charset=utf-8

/ecology/*.mjs
  Content-Type: text/javascript; charset=utf-8

/ecology/content/*.mjs
  Content-Type: text/javascript; charset=utf-8

/ecology/app.js
  Cache-Control: no-cache

/ecology/sync.mjs
  Cache-Control: no-cache
