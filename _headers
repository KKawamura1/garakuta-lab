# Cloudflare Pages がESモジュールを正しく配信するための明示的なMIME設定。
/core/*
  Content-Type: text/javascript; charset=utf-8

/ecology/*.mjs
  Content-Type: text/javascript; charset=utf-8

/ecology/content/*.mjs
  Content-Type: text/javascript; charset=utf-8

/ecology/app.js
  Cache-Control: no-cache

/ecology/sync.mjs
  Cache-Control: no-cache

# 配信用の画（タイトルの5人・会話の立ち絵）。**中身が変わるのは作り直したときだけ**なので、
# 端末へ一日残す。作り直したら `analysis/art-web-assets.py` を回して差し替える。
/ecology/art/*
  Cache-Control: public, max-age=86400
